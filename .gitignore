# Keil MDK generated build outputs
MDK-ARM/Objects/
MDK-ARM/Listings/
MDK-ARM/*.log
MDK-ARM/*.uvguix.*
MDK-ARM/*.uvgui.*
MDK-ARM/*.uvgui

# EIDE / local build outputs
build/
.uvtmp/

# Release binaries generated from Keil builds
Release/Latest/*.axf
Release/Latest/*.hex
Release/Latest/*.map
Release/Latest/*.log
Release/Archive/**/*.axf
Release/Archive/**/*.hex
Release/Archive/**/*.map
Release/Archive/**/*.log

# Local editor / assistant state
.claude/settings.local.json
.codex_lora_ref/
.vscode/
.idea/
.vs/
.cursor/
*.code-workspace

# OS generated files
Thumbs.db
Desktop.ini

# Python tools output
Tools/__pycache__/

# Local document generation caches and temporary review outputs
Reports/**/.build/
/output/
/tmp/

# Local assistant memory and whole-folder reading records
/PROJECT_MEMORY.json
/docs/Project_Memory/

# Candidate source/binary delivery bundles and Keil HTML logs stay out of source history
Release/Archive/**/*.zip
Release/Latest/*.zip
Release/**/*.build_log.htm
Release/**/*.htm
**/~$*
**/__pycache__/
*.pyc
